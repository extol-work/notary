target/
Cargo.lock
.DS_Store
*.swp
.idea/
.vscode/

# Never commit signing key material. This ignore is intentionally aggressive:
# keyfiles at any path, in any subdirectory, are ignored by default. To include
# a fixture keyfile in the repo (e.g. test vectors), it must be explicitly
# force-added AND live under fixtures/ or vectors/.
*.key
!fixtures/**/*.key
!vectors/**/*.key

# Attestation files and payloads produced by smoke tests at the repo root.
# These are the shapes that leaked in the first accidental commit. Ignored
# at the repo root only; test fixtures under fixtures/ or vectors/ are
# intentional and tracked.
/attestation.json
/hello.json
/*.attestation.json
/*.payload.json

# Solana-format keypair files (JSON array of 64 bytes). Solana's convention
# is to store keypairs as `[NN,NN,...]` JSON arrays; the CLI ecosystem uses
# .json suffixes for these, which makes them dangerous to distinguish from
# generic JSON. Block anything under keys/ or with -keypair.json suffix,
# and any file matching Solana's default id.json name.
/keys/
*-keypair.json
*.keypair.json
/id.json
/devnet-fee-payer.json
/mainnet-fee-payer.json
